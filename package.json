{
  "name": "@scorsync/private-lessons",
  "version": "0.2.0",
  "private": false,
  "description": "MCP server and CLI for the Private Lessons REST API. The HTTP client is generated from contract/openapi.yaml.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "gymnastics",
    "scheduling",
    "private-lessons"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AustinW/private-lessons-mcp.git"
  },
  "homepage": "https://github.com/AustinW/private-lessons-mcp#readme",
  "bugs": {
    "url": "https://github.com/AustinW/private-lessons-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "private-lessons": "dist/cli/index.js",
    "private-lessons-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "contract",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript contract/openapi.yaml --output src/generated/openapi.ts --root-types",
    "generate:check": "npm run generate && git diff --exit-code -- src/generated",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run generate && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "commander": "^14.0.2",
    "openapi-fetch": "^0.15.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "@hono/node-server": "^2.0.5"
  }
}
